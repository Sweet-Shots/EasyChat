# Copy this file to ".env" and edit it. Never commit your real .env.

# Port the server listens on.
PORT=3000

# Passcode everyone must type alongside their username.
# Leave blank or delete the line to let anyone with the link walk in.
ROOM_PASSWORD=changeme

# Tenor API key for GIF search (https://developers.google.com/tenor/guides/quickstart).
# Without it the GIF button shows a "not configured" note and everything else works.
TENOR_API_KEY=

# Where chat JSON files live. Defaults to "EasyChat Chats" next to this project.
# CHATS_DIR=/absolute/path/to/EasyChat Chats

# Messages kept per room before the oldest are trimmed from the JSON file.
MAX_MESSAGES_PER_ROOM=2000
