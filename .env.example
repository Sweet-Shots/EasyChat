# Copy this file to ".env" and edit it. Never share your real .env.

# Port the server listens on.
PORT=3000

# Code required to CREATE an account. Signing in afterwards needs only the
# person's own username and password.
# Leave blank to let anyone with the link register.
INVITE_CODE=changeme

# Extra accounts that should have host powers, by username, comma separated.
# The first account ever created is always a host.
# HOST_USERS=riley,sam

# Tenor API key for GIF search (https://developers.google.com/tenor/guides/quickstart).
# Without it the GIF button shows a "not configured" note and everything else works.
TENOR_API_KEY=

# Where chat JSON files live. Defaults to "EasyChat Chats" next to this file.
# Windows example:  CHATS_DIR=C:\Users\you\Documents\EasyChat Chats
# CHATS_DIR=

# Messages kept per room before the oldest are trimmed from the JSON file.
MAX_MESSAGES_PER_ROOM=2000
